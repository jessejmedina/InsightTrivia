{
  "expo": {
    "name": "Insight Trivia",
    "slug": "insight-trivia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "insighttrivia",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mtm.insighttrivia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.mtm.insighttrivia"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
